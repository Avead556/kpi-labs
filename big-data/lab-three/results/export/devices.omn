Prefix: : <http://kpi.ua/ontologies/devices.owl#>
Prefix: owl: <http://www.w3.org/2002/07/owl#>
Prefix: rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
Prefix: rdfs: <http://www.w3.org/2000/01/rdf-schema#>
Prefix: xml: <http://www.w3.org/XML/1998/namespace>
Prefix: xsd: <http://www.w3.org/2001/XMLSchema#>



Ontology: <http://kpi.ua/ontologies/devices.owl>


Annotations: 
    rdfs:comment "Технічні пристрої (смартфон, планшет, ноутбук, смарт-годинник, настільний комп'ютер), їхні компоненти, виробники й операційні системи. Варіант 5 лабораторної роботи №3 з дисципліни «Обробка надвеликих масивів даних»"@uk,
    rdfs:label "Онтологія технічних пристроїв"@uk,
    owl:versionInfo "1.0"

AnnotationProperty: owl:versionInfo

    
AnnotationProperty: rdfs:comment

    
AnnotationProperty: rdfs:label

    
Datatype: rdf:PlainLiteral

    
Datatype: xsd:decimal

    
Datatype: xsd:integer

    
Datatype: xsd:string

    
ObjectProperty: developedBy

    Annotations: 
        rdfs:label "розроблена"@uk
    
    Characteristics: 
        Functional
    
    Domain: 
        OperatingSystem
    
    Range: 
        Manufacturer
    
    
ObjectProperty: hasBattery

    Annotations: 
        rdfs:label "має акумулятор"@uk
    
    SubPropertyOf: 
        hasComponent
    
    Range: 
        Battery
    
    
ObjectProperty: hasCamera

    Annotations: 
        rdfs:label "має камеру"@uk
    
    SubPropertyOf: 
        hasComponent
    
    Range: 
        Camera
    
    
ObjectProperty: hasComponent

    Annotations: 
        rdfs:label "має компонент"@uk
    
    Domain: 
        Device
    
    Range: 
        Component
    
    InverseOf: 
        isComponentOf
    
    
ObjectProperty: hasMemory

    Annotations: 
        rdfs:label "має оперативну пам'ять"@uk
    
    SubPropertyOf: 
        hasComponent
    
    Range: 
        Memory
    
    
ObjectProperty: hasProcessor

    Annotations: 
        rdfs:label "має процесор"@uk
    
    SubPropertyOf: 
        hasComponent
    
    Range: 
        Processor
    
    
ObjectProperty: hasScreen

    Annotations: 
        rdfs:label "має екран"@uk
    
    SubPropertyOf: 
        hasComponent
    
    Range: 
        Screen
    
    
ObjectProperty: hasStorage

    Annotations: 
        rdfs:label "має накопичувач"@uk
    
    SubPropertyOf: 
        hasComponent
    
    Range: 
        Storage
    
    
ObjectProperty: isComponentOf

    Annotations: 
        rdfs:label "є компонентом"@uk
    
    InverseOf: 
        hasComponent
    
    
ObjectProperty: manufacturedBy

    Annotations: 
        rdfs:label "виготовлений"@uk
    
    Characteristics: 
        Functional
    
    Domain: 
        Device
    
    Range: 
        Manufacturer
    
    InverseOf: 
        manufactures
    
    
ObjectProperty: manufactures

    Annotations: 
        rdfs:label "виготовляє"@uk
    
    InverseOf: 
        manufacturedBy
    
    
ObjectProperty: runsOn

    Annotations: 
        rdfs:label "працює під"@uk
    
    Domain: 
        Device
    
    Range: 
        OperatingSystem
    
    
DataProperty: capacityMAh

    Annotations: 
        rdfs:label "ємність акумулятора, мА·год"@uk
    
    Characteristics: 
        Functional
    
    Domain: 
        Battery
    
    Range: 
        xsd:integer
    
    
DataProperty: clockSpeedGHz

    Annotations: 
        rdfs:label "частота процесора, ГГц"@uk
    
    Characteristics: 
        Functional
    
    Domain: 
        Processor
    
    Range: 
        xsd:decimal
    
    
DataProperty: coreCount

    Annotations: 
        rdfs:label "кількість ядер"@uk
    
    Characteristics: 
        Functional
    
    Domain: 
        Processor
    
    Range: 
        xsd:integer
    
    
DataProperty: megapixels

    Annotations: 
        rdfs:label "роздільність камери, Мп"@uk
    
    Characteristics: 
        Functional
    
    Domain: 
        Camera
    
    Range: 
        xsd:decimal
    
    
DataProperty: modelName

    Annotations: 
        rdfs:label "модель"@uk
    
    Characteristics: 
        Functional
    
    Domain: 
        Device
    
    Range: 
        xsd:string
    
    
DataProperty: releaseYear

    Annotations: 
        rdfs:label "рік випуску"@uk
    
    Characteristics: 
        Functional
    
    Domain: 
        Device
    
    Range: 
        xsd:integer
    
    
DataProperty: resolution

    Annotations: 
        rdfs:label "роздільна здатність"@uk
    
    Characteristics: 
        Functional
    
    Domain: 
        Screen
    
    Range: 
        xsd:string
    
    
DataProperty: screenSizeInches

    Annotations: 
        rdfs:label "розмір екрана, дюймів"@uk
    
    Characteristics: 
        Functional
    
    Domain: 
        Screen
    
    Range: 
        xsd:decimal
    
    
DataProperty: sizeGB

    Annotations: 
        rdfs:label "обсяг, ГБ"@uk
    
    Characteristics: 
        Functional
    
    Domain: 
        Memory or Storage
    
    Range: 
        xsd:integer
    
    
Class: Battery

    Annotations: 
        rdfs:label "Акумулятор"@uk
    
    SubClassOf: 
        Component
    
    
Class: Camera

    Annotations: 
        rdfs:label "Камера"@uk
    
    SubClassOf: 
        Component
    
    
Class: CameraDevice

    Annotations: 
        rdfs:comment "Визначений клас: пристрій, що має хоча б одну камеру"@uk,
        rdfs:label "Пристрій з камерою"@uk
    
    EquivalentTo: 
        Device
         and (hasCamera some Camera)
    
    SubClassOf: 
        Device
    
    
Class: Component

    Annotations: 
        rdfs:comment "Складова частина пристрою"@uk,
        rdfs:label "Компонент"@uk
    
    SubClassOf: 
        owl:Thing
    
    
Class: DesktopComputer

    Annotations: 
        rdfs:label "Настільний комп'ютер"@uk
    
    SubClassOf: 
        StationaryDevice,
        hasProcessor some Processor,
        hasScreen max 0 Screen
    
    
Class: Device

    Annotations: 
        rdfs:comment "Електронний пристрій, яким користується людина"@uk,
        rdfs:label "Технічний пристрій"@uk
    
    SubClassOf: 
        owl:Thing
    
    
Class: Laptop

    Annotations: 
        rdfs:label "Ноутбук"@uk
    
    SubClassOf: 
        PortableDevice,
        hasMemory some Memory,
        hasProcessor some Processor,
        hasStorage some Storage,
        hasScreen exactly 1 Screen
    
    
Class: LargeScreenDevice

    Annotations: 
        rdfs:comment "Визначений клас: екран від 10 дюймів"@uk,
        rdfs:label "Пристрій з великим екраном"@uk
    
    EquivalentTo: 
        Device
         and (hasScreen some 
            (Screen
             and (screenSizeInches some xsd:decimal[>= 10.0])))
    
    SubClassOf: 
        Device
    
    
Class: Manufacturer

    Annotations: 
        rdfs:label "Виробник"@uk
    
    SubClassOf: 
        owl:Thing
    
    
Class: Memory

    Annotations: 
        rdfs:label "Оперативна пам'ять"@uk
    
    SubClassOf: 
        Component
    
    
Class: OperatingSystem

    Annotations: 
        rdfs:label "Операційна система"@uk
    
    SubClassOf: 
        owl:Thing
    
    
Class: PortableDevice

    Annotations: 
        rdfs:comment "Пристрій з власним акумулятором, який носять із собою"@uk,
        rdfs:label "Портативний пристрій"@uk
    
    SubClassOf: 
        Device,
        hasBattery some Battery
    
    DisjointWith: 
        StationaryDevice
    
    
Class: Processor

    Annotations: 
        rdfs:label "Процесор"@uk
    
    SubClassOf: 
        Component
    
    
Class: Screen

    Annotations: 
        rdfs:label "Екран"@uk
    
    SubClassOf: 
        Component
    
    
Class: Smartphone

    Annotations: 
        rdfs:label "Смартфон"@uk
    
    SubClassOf: 
        PortableDevice,
        hasCamera some Camera,
        hasProcessor some Processor,
        runsOn some OperatingSystem,
        hasBattery exactly 1 Battery,
        hasScreen exactly 1 Screen
    
    
Class: Smartwatch

    Annotations: 
        rdfs:label "Смарт-годинник"@uk
    
    SubClassOf: 
        PortableDevice,
        hasScreen exactly 1 Screen,
        hasCamera max 0 Camera
    
    
Class: StationaryDevice

    Annotations: 
        rdfs:comment "Пристрій, що працює від мережі на одному місці"@uk,
        rdfs:label "Стаціонарний пристрій"@uk
    
    SubClassOf: 
        Device
    
    DisjointWith: 
        PortableDevice
    
    
Class: Storage

    Annotations: 
        rdfs:label "Накопичувач"@uk
    
    SubClassOf: 
        Component
    
    
Class: Tablet

    Annotations: 
        rdfs:label "Планшет"@uk
    
    SubClassOf: 
        PortableDevice,
        hasProcessor some Processor,
        hasScreen exactly 1 Screen
    
    
Class: owl:Thing

    
